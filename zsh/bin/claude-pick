#!/usr/bin/env zsh
# claude-pick: pick a running Claude Code session with fzf and jump to its pane.
#
# Reads the registry Claude Code keeps for its running processes, one JSON
# file per pid, which records the session's display name, working directory,
# idle/busy status, and the tmux pane it runs in. Dead pids and panes that no
# longer exist are dropped. A window flagged by claude-attn (its @attn option,
# set from Claude Code hooks) shows ? for a pending permission or ✓ for a
# finished turn, and sorts to the top.
#
# Run from a tmux binding (see tmux.conf), it opens a popup sized to fit: the
# session list on top and a preview of the chosen pane below it, half the
# client's height, so the popup has no blank space of its own. It then runs
# itself inside the popup with --in-popup <preview lines>. Dropping trailing
# blank lines from the pane capture before taking its tail keeps the preview
# full when a pane's conversation is shorter than the pane.

emulate -L zsh
setopt pipe_fail extended_glob

local registry=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sessions
local -a panes rows
panes=(${(f)"$(tmux list-panes -a -F '#{pane_id}')"})

local f pid state name cwd pane attn glyph rank
for f in $registry/*.json(N); do
  pid=${${f:t}%.json}
  kill -0 $pid 2>/dev/null || continue
  IFS=$'\t' read -r state name cwd pane < <(
    jq -r --arg home "$HOME" \
      '[.status, .name, (.cwd | sub("^\($home)"; "~")), ((.tmux // "") | sub("^.*\\."; ""))] | @tsv' "$f"
  )
  [[ -n $pane && -n ${panes[(r)$pane]} ]] || continue
  attn=$(tmux show-options -wqv -t "$pane" @attn)
  case $attn:$state in
    permission:*) rank=0 glyph='?' ;;
    done:*)       rank=1 glyph='✓' ;;
    *:busy)       rank=3 glyph='●' ;;
    *)            rank=2 glyph='○' ;;
  esac
  rows+=("$(printf '%s\t%s\t%-20s\t%s\t%s' "$rank" "$glyph" "$name" "$cwd" "$pane")")
done

if (( ! $#rows )); then
  tmux display-message 'no claude sessions running in tmux'
  exit 0
fi

local preview_lines
if [[ $1 == --in-popup ]]; then
  preview_lines=${2:-40}
else
  # Popup height: the list rows, fzf's header, info and prompt lines, the
  # preview and its top border, and the popup's own two border lines.
  preview_lines=$(( $(tmux display -p '#{client_height}') / 2 ))
  (( preview_lines < 15 )) && preview_lines=15
  exec tmux display-popup -E -w 80% -h $(( $#rows + 3 + preview_lines + 1 + 2 )) \
    "$0 --in-popup $preview_lines"
fi

local preview='lines=("${(@f)$(tmux capture-pane -p -e -t {5})}")
while (( $#lines )) && [[ -z ${lines[-1]//[[:space:]]/} ]]; do lines[-1]=(); done
n=${FZF_PREVIEW_LINES:-40}; (( n > $#lines )) && n=$#lines
(( n )) && print -l -- "${(@)lines[-n,-1]}"'

# --height 100% overrides any --height in FZF_DEFAULT_OPTS, which would leave
# the rest of the popup blank.
local choice
choice=$(print -l ${(o)rows} | fzf \
  --no-tmux --height 100% --reverse --ansi \
  --delimiter '\t' --with-nth 2,3,4 --tabstop 1 \
  --header '? permission  ✓ done  ○ idle  ● busy' \
  --preview "$preview" \
  --preview-window "down,$preview_lines,border-top") || exit 0

tmux switch-client -t "${choice##*$'\t'}"
