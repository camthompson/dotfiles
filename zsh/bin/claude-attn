#!/usr/bin/env zsh
# claude-attn: keep the tmux window a Claude Code session runs in labelled
# with what the session is doing.
#
# Run from Claude Code hooks (see ~/.claude/settings.json), so it inherits
# TMUX_PANE from the session that fired. The first argument is the hook event;
# it sets the window option @claude to one of four states:
#
#   event        hook               @claude
#   start        SessionStart       idle
#   prompt       UserPromptSubmit   busy
#   permission   PermissionRequest  permission  a tool is waiting for approval
#   tool         PostToolUse        busy        the prompt was answered
#   stop         Stop               idle if you're looking at the window,
#                                   done if not
#   end          SessionEnd         (unset)
#
# tmux.conf renders @claude as a glyph after the window name (● busy, ○ idle,
# ? permission, ✓ done), and claude-pick lists sessions by the same state,
# needing you first. For permission and done in a window you aren't looking
# at, the hook also shows a one-line message in the status bar.
#
# Interrupting a turn with Escape fires Stop, so the state recovers. Cancelling
# a permission prompt with Escape fires nothing, so ? stays until the next
# prompt; you're looking at that window when you cancel, so it's harmless.

emulate -L zsh

local event=$1
cat > /dev/null  # drain the hook's JSON so Claude Code never blocks writing it

[[ -n $TMUX_PANE ]] || exit 0

local active name
IFS=$'\t' read -r active name < <(tmux display-message -p -t "$TMUX_PANE" $'#{window_active}\t#W')

case $event in
  start)
    tmux set-option -w -t "$TMUX_PANE" @claude idle
    ;;
  prompt|tool)
    tmux set-option -w -t "$TMUX_PANE" @claude busy
    ;;
  permission)
    tmux set-option -w -t "$TMUX_PANE" @claude permission
    [[ $active == 1 ]] || tmux display-message -t "$TMUX_PANE" "$name needs permission"
    ;;
  stop)
    if [[ $active == 1 ]]; then
      tmux set-option -w -t "$TMUX_PANE" @claude idle
    else
      tmux set-option -w -t "$TMUX_PANE" @claude done
      tmux display-message -t "$TMUX_PANE" "$name is done"
    fi
    ;;
  end)
    tmux set-option -wu -t "$TMUX_PANE" @claude 2>/dev/null
    ;;
  *)
    print -u2 "usage: claude-attn start|prompt|permission|tool|stop|end"
    exit 1
    ;;
esac
