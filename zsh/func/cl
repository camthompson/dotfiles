# cl: open or reopen a named Claude Code session in its own tmux window.
#
# The first word is a short slug. It becomes both the tmux window name and the
# Claude session name (`claude --name`), so the window title stays stable and
# `cl <slug>` finds the session again later. A bare number is a ticket and
# expands to `${CL_TICKET_PREFIX:-eng}-<number>`. Any further words are the
# prompt: the opening prompt for a new session, or the next message for an
# existing one.
#
# Sessions are recorded in a tab-separated ledger (name, directory, created,
# session id) so completion and reopening don't depend on Claude's transcript
# format. New sessions get a UUID up front and are resumed by it, so a name can
# be reused for a fresh session (-n) without `--resume` becoming ambiguous.
# Lines written before the id column resume by name.

emulate -L zsh
setopt pipe_fail extended_glob

local -A opt
zparseopts -D -M -A opt d: w n l h

local ledger="${XDG_STATE_HOME:-$HOME/.local/state}/cl/sessions"

if (( ${+opt[-h]} )); then
  cat <<USAGE
usage: cl [-n] [-w] [-d DIR] <name> [prompt...]
       cl
       cl -l

Open a Claude Code session named <name> in a tmux window of the same name.
A bare number expands to ${CL_TICKET_PREFIX:-eng}-<number>.
If a window called <name> is already open in this tmux session, switch to it
and type the prompt, if any, into it.
If <name> was used before, resume that session in the directory it started in
and send the prompt, if any.
Otherwise start a new session in DIR (default: the current directory) with the
prompt as its first message.

New and resumed sessions run in the current tmux window, which is renamed to
<name> until claude exits. With -w they open in a new window named <name>
instead.

With no arguments, pick a known session with fzf, most recent first.
Outside tmux, claude runs in the current terminal instead of a new window.

Options:
  -n      Start a new session even if <name> is known or its window is open.
          It starts where the old one did unless -d says otherwise, and
          replaces it as the session <name> resumes.
  -w      Open a new window instead of running in the current one.
  -d DIR  Directory to start a new session in.
  -l      List known sessions. A leading * marks ones with an open window.
  -h      Show this help.
USAGE
  return 0
fi

local -a open
[[ -n $TMUX ]] && open=(${(f)"$(tmux list-windows -F '#W')"})

if (( ${+opt[-l]} )); then
  [[ -s $ledger ]] || { print "no sessions recorded in $ledger"; return 0; }
  local name dir created id
  while IFS=$'\t' read -r name dir created id; do
    printf '%s %-20s %s  %s\n' "${open[(re)$name]:+*}" "$name" "${dir/#$HOME/~}" "$created"
  done < "$ledger"
  return 0
fi

if (( ARGC == 0 )); then
  [[ -s $ledger ]] || { print -u2 "cl: no sessions recorded yet"; return 1; }
  local -a rows
  local name dir created id
  while IFS=$'\t' read -r name dir created id; do
    rows=("$(printf '%s\t%-20s\t%s\t%s' "${open[(re)$name]:+*}" "$name" "${dir/#$HOME/~}" "$created")" $rows)
  done < "$ledger"
  local choice
  choice=$(print -l $rows | fzf --delimiter '\t' --tabstop 1 --header '* open' --nth 2) || return 1
  cl "${${(s:	:)choice}[2]// /}"
  return
fi

local name=$1; shift
local prompt="$*"

[[ $name == <-> ]] && name="${CL_TICKET_PREFIX:-eng}-$name"

if [[ $name != [A-Za-z0-9][A-Za-z0-9._-]# ]]; then
  print -u2 "cl: name must be letters, digits, dot, dash, or underscore: $name"
  return 1
fi

# Already open in this tmux session. If claude is running there, go there and
# hand over the prompt. If the window has fallen back to a shell (a -w window
# keeps its name after claude exits), remember it so the session can be
# started or resumed in that window instead of typing the prompt into zsh.
local win reuse=
if [[ -n $TMUX && ! ${+opt[-n]} -eq 1 ]]; then
  local wcmd
  IFS=' ' read -r win wcmd < <(
    tmux list-windows -F '#{window_id} #W #{pane_current_command}' |
      awk -v n="$name" '$2 == n { print $1, $3; exit }'
  )
  if [[ -n $win ]]; then
    if [[ $wcmd == claude || $wcmd == <->.<->.<-> ]]; then
      tmux select-window -t "$win"
      [[ -n $prompt ]] && tmux send-keys -t "$win" -l "$prompt" && tmux send-keys -t "$win" Enter
      return
    elif [[ $wcmd == (zsh|bash|fish|sh) ]]; then
      reuse=$win
    else
      print -u2 "cl: window $name is running $wcmd; starting elsewhere"
    fi
  fi
fi

# Known session: resume it where it started, or with -n start over there.
local dir id known=
if [[ -s $ledger ]]; then
  local -a hit
  hit=(${(f)"$(awk -F'\t' -v n="$name" '$1 == n { print $2; print $4; exit }' "$ledger")"})
  if (( $#hit )); then
    known=1
    dir=$hit[1]
    id=$hit[2]
    if [[ -n $opt[-d] && ! ${+opt[-n]} -eq 1 && ${~opt[-d]:A} != $dir ]]; then
      print -u2 "cl: $name already lives in ${dir/#$HOME/~}; ignoring -d"
    fi
  fi
fi

local fresh=
if [[ -z $known || ${+opt[-n]} -eq 1 ]]; then
  fresh=1
  dir=${~${opt[-d]:-${dir:-$PWD}}:A}
  [[ -d $dir ]] || { print -u2 "cl: no such directory: $dir"; return 1; }
  id=${(L)"$(uuidgen)"}
fi

local -a cmd
if [[ -n $fresh ]]; then
  cmd=(claude --name "$name" --session-id "$id")
else
  cmd=(claude --resume "${id:-$name}")
fi
[[ -n $prompt ]] && cmd+=("$prompt")

if [[ -n $fresh ]]; then
  mkdir -p "${ledger:h}"
  if [[ -n $known ]]; then
    awk -F'\t' -v n="$name" '$1 != n' "$ledger" > "$ledger.tmp" && mv "$ledger.tmp" "$ledger"
  fi
  printf '%s\t%s\t%s\t%s\n' "$name" "$dir" "$(date +%Y-%m-%dT%H:%M)" "$id" >> "$ledger"
fi

if [[ -z $TMUX ]]; then
  cd "$dir" && "${cmd[@]}"
  return
fi

# A window of this name sitting at a shell prompt: run the session there.
if [[ -n $reuse ]]; then
  tmux select-window -t "$reuse"
  tmux send-keys -t "$reuse" "cd ${(q)dir} && ${(j: :)${(q)cmd[@]}}" C-m
  return
fi

# New window: a window named at creation has automatic-rename off, so the
# title sticks. Sending the command to a shell (rather than running it as the
# window's process) leaves a shell behind when claude exits.
if (( ${+opt[-w]} )); then
  win=$(tmux new-window -P -F '#{window_id}' -n "$name" -c "$dir")
  tmux send-keys -t "$win" "${(j: :)${(q)cmd[@]}}" C-m
  return
fi

# In place: rename this window, which also turns off automatic-rename for it,
# run claude here, and let the name float again afterwards.
tmux rename-window -t "$TMUX_PANE" "$name"
pushd -q "$dir"
"${cmd[@]}"
local rc=$?
popd -q
tmux set-window-option -t "$TMUX_PANE" automatic-rename on
return $rc
