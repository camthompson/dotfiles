# clw: open the session for a ticket and ask what to do next.
# `clw 1234` is `cl 1234 "what are the next steps for eng-1234?"`.
# With no ticket, pick a Linear issue with cli first.

emulate -L zsh
local -A opt
zparseopts -D -M -A opt d: w
local -a args
(( ${+opt[-w]} )) && args+=(-w)
[[ -n $opt[-d] ]] && args+=(-d "$opt[-d]")
(( ARGC == 0 )) && { cli "${args[@]}"; return }
(( ARGC == 1 )) || { print -u2 'usage: clw [-w] [-d DIR] [ticket]'; return 1; }
local name=$1
[[ $name == <-> ]] && name="${CL_TICKET_PREFIX:-eng}-$name"
cl "${args[@]}" "$name" "what are the next steps for $name?"
