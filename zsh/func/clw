# clw: open the work session for a ticket and ask what to do next.
# `clw 1234` is `cl wrk-1234 "what are the next steps for eng-1234?"`,
# resuming the ticket's work session when there is one; -n starts a fresh one
# instead. The session is named `wrk-<number>` so it sits beside the
# `rvw-<number>` session clr opens instead of replacing it. The ticket can
# also be given as `eng-1234`, `wrk-1234` or `rvw-1234`. Any other name is
# used as it is. Plain `cl 1234` opens the same session without the prompt.
# With no ticket, pick a Linear issue with cli first (fresh unless -r; -a
# starts the picker on every open issue, not only yours). In tmux the picker
# takes several issues: the first opens here and each of the others in a new
# window.

emulate -L zsh
local -A opt
zparseopts -D -M -A opt d: w n r a
local -a args
(( ${+opt[-w]} )) && args+=(-w)
[[ -n $opt[-d] ]] && args+=(-d "$opt[-d]")
(( ARGC == 0 )) && { cli ${opt[-r]+-r} ${opt[-a]+-a} "${args[@]}"; return }
(( ARGC == 1 )) || { print -u2 'usage: clw [-n] [-w] [-d DIR] <ticket>
       clw [-a] [-r] [-w] [-d DIR]'; return 1; }
(( ${+opt[-n]} )) && args+=(-n)
local prefix=${(L)${CL_TICKET_PREFIX:-eng}}
local name=$1 subject=$1
local MATCH MBEGIN MEND; local -a match mbegin mend
if [[ ${(L)1} =~ "^((${prefix}|wrk|rvw)-)?([0-9]+)\$" ]]; then
  subject="$prefix-$match[3]" name="wrk-$match[3]"
fi
cl "${args[@]}" "$name" "what are the next steps for $subject?"
