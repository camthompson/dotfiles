# clw: open the session for a ticket and ask what to do next.
# `clw 1234` is `cl 1234 "what are the next steps for eng-1234?"`.

emulate -L zsh
local -A opt
zparseopts -D -M -A opt d: i
(( ARGC == 1 )) || { print -u2 'usage: clw [-i] [-d DIR] <ticket>'; return 1; }
local name=$1
[[ $name == <-> ]] && name="${CL_TICKET_PREFIX:-eng}-$name"
cl ${opt[-i]+-i} ${opt[-d]:+-d "$opt[-d]"} "$name" "what are the next steps for $name?"
