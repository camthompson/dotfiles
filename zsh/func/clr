# clr: open a fresh review session for a ticket and review its open pull
# requests. `clr 1234` is
# `cl -n rvw-1234 "review prs open for eng-1234; don't run checks"`: a new
# session each time, so a rerun after changes starts without the last review's
# context. -r resumes the ticket's existing review session instead. The
# session is named `rvw-<number>` so it sits beside the `wrk-<number>` session
# clw opens instead of replacing it. The ticket can also be given as
# `eng-1234`, `rvw-1234` or `wrk-1234`. Any other name is used as it is.
# With no ticket, pick a pull request with clp first (-a starts the picker on
# every open pull request, not only yours). In tmux the picker takes several
# pull requests: the first opens here and each of the others in a new window.

emulate -L zsh
local -A opt
zparseopts -D -M -A opt d: w r a
local -a args
(( ${+opt[-w]} )) && args+=(-w)
[[ -n $opt[-d] ]] && args+=(-d "$opt[-d]")
(( ARGC == 0 )) && { clp ${opt[-r]+-r} ${opt[-a]+-a} "${args[@]}"; return }
(( ARGC == 1 )) || { print -u2 'usage: clr [-r] [-w] [-d DIR] <ticket>
       clr [-a] [-r] [-w] [-d DIR]'; return 1; }
(( ${+opt[-r]} )) || args+=(-n)
local prefix=${(L)${CL_TICKET_PREFIX:-eng}}
local name=$1 subject=$1
local MATCH MBEGIN MEND; local -a match mbegin mend
if [[ ${(L)1} =~ "^((${prefix}|wrk|rvw)-)?([0-9]+)\$" ]]; then
  subject="$prefix-$match[3]" name="rvw-$match[3]"
fi
cl "${args[@]}" "$name" "review prs open for $subject; don't run checks"
