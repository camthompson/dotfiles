#!/usr/bin/env ruby

# Ensure we're running from the dotfiles repo root
script_dir = File.expand_path(File.dirname(__FILE__))
Dir.chdir(script_dir)

unless File.exist?("update") && File.exist?("zshrc")
  $stderr.puts "Error: must run from dotfiles repository root"
  exit 1
end

print "This will update submodules and pull changes. Type 'yes' to confirm: "
confirmation = gets&.chomp
unless confirmation == "yes"
  puts "Aborted."
  exit 1
end

# Update all submodules (themes and zsh plugins)
puts "Updating submodules..."
puts "  Updating zsh plugins..."
`git submodule update --remote zsh/bundle/`
puts "  Updating Catppuccin themes..."
`git submodule update --remote themes/`

# Track if any themes were updated
theme_changes = []
theme_changes << "atuin" if system("git diff --quiet HEAD themes/catppuccin-atuin") == false
theme_changes << "bat" if system("git diff --quiet HEAD themes/catppuccin-bat") == false
theme_changes << "btop" if system("git diff --quiet HEAD themes/catppuccin-btop") == false
theme_changes << "eza" if system("git diff --quiet HEAD themes/catppuccin-eza") == false
theme_changes << "lsd" if system("git diff --quiet HEAD themes/catppuccin-lsd") == false
theme_changes << "glamour" if system("git diff --quiet HEAD themes/catppuccin-glamour") == false
theme_changes << "ghostty" if system("git diff --quiet HEAD themes/catppuccin-ghostty") == false
theme_changes << "lazygit" if system("git diff --quiet HEAD themes/catppuccin-lazygit") == false
theme_changes << "starship" if system("git diff --quiet HEAD themes/catppuccin-starship") == false
theme_changes << "fsh" if system("git diff --quiet HEAD themes/catppuccin-fsh") == false
theme_changes << "fzf" if system("git diff --quiet HEAD themes/catppuccin-fzf") == false
theme_changes << "k9s" if system("git diff --quiet HEAD themes/catppuccin-k9s") == false

# Re-apply themes if any were updated
if theme_changes.any?
  puts "Theme updates detected for: #{theme_changes.join(', ')}"
  puts "Re-applying theme configurations..."

  # Replace everything from the theme marker to the end of config_file with
  # the current theme file. Trailing blank lines above the marker are trimmed
  # so repeated runs do not accumulate empty lines.
  apply_theme = lambda do |name, config_file, theme_file|
    theme_marker = "# === CATPPUCCIN THEME START (auto-generated, do not edit below) ==="
    return unless File.exist?(config_file)

    contents = File.read(config_file)
    marker_at = contents.index(theme_marker)
    return unless marker_at

    `cp #{config_file} #{config_file}.bak`
    head = contents[0...marker_at].rstrip
    File.write(config_file, "#{head}\n\n#{theme_marker}\n#{File.read(theme_file)}")
    puts "  ✓ #{name} theme updated"
  end

  if theme_changes.include?("lazygit") && File.directory?("themes/catppuccin-lazygit")
    apply_theme.call("lazygit", "lazygit/config.yml", "themes/catppuccin-lazygit/themes-mergable/mocha/mauve.yml")
  end

  if theme_changes.include?("starship") && File.directory?("themes/catppuccin-starship")
    apply_theme.call("starship", "starship.toml", "themes/catppuccin-starship/themes/mocha.toml")
  end

  # Rebuild bat cache if bat theme was updated
  if theme_changes.include?("bat")
    puts "  Rebuilding bat cache..."
    `bat cache --build 2>/dev/null`
    puts "  ✓ bat cache rebuilt"
  end
end

# Upgrade gh extensions
puts "Upgrading gh extensions..."
`gh extension upgrade --all 2>/dev/null`
puts "  ✓ gh extensions upgraded"

`git pull`

puts "Done. Run `git status` to review any changes."
